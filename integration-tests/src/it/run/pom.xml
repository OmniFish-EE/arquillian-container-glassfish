<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>glassfish-containers-main</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../..</relativePath>
    </parent>

    <groupId>ee.omnifish.arquillian.test</groupId>
    <artifactId>run-test</artifactId>
    <packaging>war</packaging>

    <name>Integration Test: glassfish:run</name>
    <description>
        A web application with its own context root, which verify.groovy runs
        with glassfish:run in Mavens of its own: it requests the URL run
        prints, runs it a second time while the first runs, ends the first as
        Ctrl+C would, and runs it again after a change, without clean, ending
        that with glassfish:stop. Run via integration-tests' maven-invoker
        harness.
    </description>

    <properties>
        <container.version>@project.version@</container.version>
        <glassfish.version>@glassfish.version@</glassfish.version>
    </properties>

    <build>
        <plugins>
            <!-- No extension, and no executions: verify.groovy runs the goals itself. -->
            <plugin>
                <groupId>ee.omnifish.glassfish</groupId>
                <artifactId>glassfish-maven-plugin</artifactId>
                <version>${container.version}</version>
                <configuration>
                    <distribution>${glassfish.version}</distribution>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
