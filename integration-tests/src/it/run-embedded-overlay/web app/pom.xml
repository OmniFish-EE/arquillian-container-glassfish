<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian.test</groupId>
        <artifactId>run-embedded-overlay-test</artifactId>
        <version>@project.version@</version>
    </parent>

    <artifactId>run-embedded-overlay-app</artifactId>
    <packaging>war</packaging>

    <build>
        <plugins>
            <!-- No extension, and no executions: verify.groovy runs the goals itself. -->
            <plugin>
                <groupId>ee.omnifish.glassfish</groupId>
                <artifactId>glassfish-maven-plugin</artifactId>
                <version>${container.version}</version>
                <configuration>
                    <edition>embedded-web</edition>
                    <version>${glassfish.version}</version>
                    <!-- Replaces GlassFish's Mojarra, so GlassFish Embedded runs from the Web profile's static shell. -->
                    <overlays>
                        <overlay>
                            <groupId>org.glassfish</groupId>
                            <artifactId>jakarta.faces</artifactId>
                            <version>${mojarra.overlay}</version>
                            <destFileName>jakarta.faces.jar</destFileName>
                        </overlay>
                    </overlays>
                    <!-- The CA verify.groovy makes, which signed the server key it serves HTTPS with. -->
                    <trustedCerts>
                        <trustedCert>
                            <alias>run-embedded-overlay-it</alias>
                            <file>${project.basedir}/trusted-ca.pem</file>
                        </trustedCert>
                    </trustedCerts>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
