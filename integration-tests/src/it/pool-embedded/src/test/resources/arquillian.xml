<?xml version="1.0"?>
<arquillian xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://jboss.org/schema/arquillian"
    xsi:schemaLocation="http://jboss.org/schema/arquillian https://jboss.org/schema/arquillian/arquillian_1_0.xsd">

    <!--
        Each container leases a slot of its own: "first" when the test JVM
        starts, "second" when SameNameOnTwoSlotsIT starts it. Arquillian
        expands ${...} from system properties; failsafe forwards gf.pool.dir.
    -->
    <group qualifier="slots" default="true">
        <container qualifier="first" default="true">
            <configuration>
                <property name="poolDir">${gf.pool.dir}</property>
                <property name="leaseTimeoutSeconds">120</property>
            </configuration>
        </container>
        <container qualifier="second" mode="manual">
            <configuration>
                <property name="poolDir">${gf.pool.dir}</property>
                <property name="leaseTimeoutSeconds">120</property>
            </configuration>
        </container>
    </group>

</arquillian>
