<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>glassfish-containers-main</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../..</relativePath>
    </parent>

    <groupId>ee.omnifish.arquillian.test</groupId>
    <artifactId>start-stop-test</artifactId>

    <name>Integration Test: glassfish:start and glassfish:stop</name>
    <description>
        Three Maven invocations: glassfish:start from a clean checkout, a test
        that GlassFish still answers after that Maven exited, and
        glassfish:stop from a fresh one. Run via integration-tests'
        maven-invoker harness.
    </description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <container.version>@project.version@</container.version>
        <glassfish.version>@glassfish.version@</glassfish.version>
        <!-- No GlassFish JUL extension on this classpath; use the JDK's LogManager. -->
        <test.logManager>java.util.logging.LogManager</test.logManager>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No extension, and no executions: the invocations run the goals themselves. -->
            <plugin>
                <groupId>ee.omnifish.glassfish</groupId>
                <artifactId>glassfish-maven-plugin</artifactId>
                <version>${container.version}</version>
                <configuration>
                    <distribution>${glassfish.version}</distribution>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
