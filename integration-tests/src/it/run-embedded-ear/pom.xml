<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>glassfish-containers-main</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../..</relativePath>
    </parent>

    <groupId>ee.omnifish.arquillian.test</groupId>
    <artifactId>run-embedded-ear-test</artifactId>
    <packaging>pom</packaging>

    <name>Integration Test: glassfish:run of an EAR on GlassFish Embedded</name>
    <description>
        An EAR with two WARs, each with the context root the EAR gives it,
        which verify.groovy runs with glassfish:run on GlassFish Embedded:
        GlassFish's banner fails for EARs, so run gets the context roots
        from the EAR. It requests both URLs run prints, and ends the run as
        Ctrl+C would. Run via integration-tests' maven-invoker harness.
    </description>

    <modules>
        <module>alpha</module>
        <module>beta</module>
        <module>ear</module>
    </modules>

    <properties>
        <container.version>@project.version@</container.version>
        <glassfish.version>@glassfish.version@</glassfish.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
