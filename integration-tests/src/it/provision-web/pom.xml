<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>glassfish-containers-main</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../..</relativePath>
    </parent>

    <groupId>ee.omnifish.arquillian.test</groupId>
    <artifactId>provision-web-test</artifactId>
    <packaging>pom</packaging>

    <name>Integration Test: glassfish:provision of the Web profile</name>
    <description>
        Provisions GlassFish with &lt;edition&gt;web&lt;/edition&gt; and a
        &lt;version&gt;, without coordinates, and checks that the Web
        profile was unpacked. Starts no server. Run via integration-tests'
        maven-invoker harness.
    </description>

    <build>
        <plugins>
            <plugin>
                <groupId>ee.omnifish.glassfish</groupId>
                <artifactId>glassfish-maven-plugin</artifactId>
                <version>@project.version@</version>
                <configuration>
                    <edition>web</edition>
                    <version>@glassfish.version@</version>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
