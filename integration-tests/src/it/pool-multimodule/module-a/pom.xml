<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian.test</groupId>
        <artifactId>pool-multimodule-test</artifactId>
        <version>@project.version@</version>
    </parent>

    <artifactId>pool-multimodule-a</artifactId>

    <name>Integration Test: GlassFish Server Pool, shared by modules (a)</name>

    <build>
        <plugins>
            <!--
                Marks the end of this module's build, after the phase where
                the extension binds down with multiModule off. The second
                module's test waits for it.
            -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>mark-finished</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <touch file="${project.build.directory}/finished"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
