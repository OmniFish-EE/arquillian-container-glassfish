<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>glassfish-containers-main</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../..</relativePath>
    </parent>

    <groupId>ee.omnifish.arquillian.test</groupId>
    <artifactId>pool-multimodule-test</artifactId>
    <packaging>pom</packaging>

    <name>Integration Test: GlassFish Server Pool, shared by modules</name>
    <description>
        Two modules, built at the same time, share one pool with multiModule:
        it lives in this project's target, both modules' tests run on the
        same server, and it stops once, after the build. Run via
        integration-tests' maven-invoker harness.
    </description>

    <modules>
        <module>module-a</module>
        <module>module-b</module>
    </modules>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <container.version>@project.version@</container.version>
        <glassfish.version>@glassfish.version@</glassfish.version>
        <!-- No GlassFish JUL extension on this classpath; use the JDK's LogManager. -->
        <test.logManager>java.util.logging.LogManager</test.logManager>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                One pool for all modules: with multiModule, poolDir and
                stageDir default to this project's target, and the extension
                stops the pool once, after the build, instead of binding down
                after each module. Each module's up starts the pool, or finds
                it running.
            -->
            <plugin>
                <groupId>ee.omnifish.arquillian</groupId>
                <artifactId>glassfish-pool-maven-plugin</artifactId>
                <version>${container.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <multiModule>true</multiModule>
                    <distribution>
                        <version>${glassfish.version}</version>
                    </distribution>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
