<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ee.omnifish.arquillian</groupId>
        <artifactId>glassfish-containers-main</artifactId>
        <version>@project.version@</version>
        <relativePath>../../../..</relativePath>
    </parent>

    <groupId>ee.omnifish.arquillian.test</groupId>
    <artifactId>run-embedded-test</artifactId>
    <packaging>war</packaging>

    <name>Integration Test: glassfish:run on GlassFish Embedded</name>
    <description>
        A web application that verify.groovy runs with glassfish:run on
        GlassFish Embedded's self-contained JAR, in Mavens of its own: it
        requests the URL run prints, checks what the post-boot command set
        and that the trusted CA is trusted, runs it a second time while the
        first runs, and ends the first as Ctrl+C would. Run via
        integration-tests' maven-invoker harness.
    </description>

    <properties>
        <container.version>@project.version@</container.version>
        <glassfish.version>@glassfish.version@</glassfish.version>
    </properties>

    <build>
        <plugins>
            <!-- No extension, and no executions: verify.groovy runs the goal itself. -->
            <plugin>
                <groupId>ee.omnifish.glassfish</groupId>
                <artifactId>glassfish-maven-plugin</artifactId>
                <version>${container.version}</version>
                <configuration>
                    <edition>embedded</edition>
                    <version>${glassfish.version}</version>
                    <!--
                        Quoted, as the value has spaces. The query comes before the plugin's own deploy and query of
                        the context root.
                    -->
                    <postBootCommands>
                        create-system-properties run.marker="from a post-boot command"
                        get configs.config.server-config.network-config.network-listeners.network-listener.http-listener.port
                    </postBootCommands>
                    <!-- The CA verify.groovy makes, which signed the server key it serves HTTPS with. -->
                    <trustedCerts>
                        <trustedCert>
                            <alias>run-embedded-it</alias>
                            <file>${project.basedir}/trusted-ca.pem</file>
                        </trustedCert>
                    </trustedCerts>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>disabled</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
