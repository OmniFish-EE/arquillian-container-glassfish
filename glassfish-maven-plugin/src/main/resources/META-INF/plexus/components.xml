<!--
    Loaded when the plugin is declared with <extensions>true</extensions>:
    binds glassfish:provision without an <executions> block and forwards
    glassfish.home to surefire and failsafe.
-->
<component-set>
    <components>
        <component>
            <role>org.apache.maven.AbstractMavenLifecycleParticipant</role>
            <role-hint>glassfish</role-hint>
            <implementation>ee.omnifish.glassfish.maven.GlassFishLifecycleParticipant</implementation>
        </component>
    </components>
</component-set>
